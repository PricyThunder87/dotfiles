{
    "height": 45,
    "include": [
        "./modules.jsonc"
    ],
    "layer": "top",
    "position": "top",
    "margin-top": 0,
    "margin-bottom": 0,
    "spacing": 0,
    "modules-left": [
        "ext/workspaces",
        "cpu",
