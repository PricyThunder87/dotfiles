{
    "cpu": {
        "interval": 1,
        "format": "   {icon0}{icon1}{icon2}{icon3} {usage:>2}%",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "on-click": "ghostty -e btop"
    },
    "memory": {
        "interval": 1,
        "format": "  {used}GB / {total}GB ({percentage}%)",
        "on-click": "ghostty -e btop"
    },
    "disk": {
        "interval": 30,
        "path": "/",
        "format": " {percentage_used}%",
        "on-click": "qdirstat"
    },
    "custom/spotify": {
        "exec": "python3 /home/noahsakko/.config/waybar/scripts/mediaplayer.py --player spotify",
        "format": "{}",
        "return-type": "json",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl previous",
        "on-scroll-down": "playerctl next"
    },
    "clock": {
        "timezone": "Europe/Amsterdam",
        "tooltip": false,
        "format": "{:%H:%M:%S - %A, %d %B %Y}",
        "interval": 1,
        "on-click": "gnome-clocks"
    },
    "custom/reload": {
        "format": "󰑓",
        "tooltip": false,
        "on-click": "$HOME/.config/waybar/scripts/reload.sh"
    },
    "bluetooth": {
        "format": "",
        "format-on": "{icon}",
        "format-off": "{icon}",
        "format-connected": "{icon}",
        "format-icons": {
            "on": "󰂯",
            "off": "󰂲",
            "connected": "󰂱"
        },
        "on-click": "blueman-manager",
        "tooltip-format-connected": "{device_enumerate}"
    },
    "custom/vpn": {
        "format": "{}",
        "interval": 3,
        "return-type": "json",
        "exec": "$HOME/.config/waybar/scripts/check-vpn-status.sh",
        "on-click": "$HOME/.config/waybar/scripts/toggle-vpn.sh",
        "on-click-right": "alacritty -e $HOME/.config/waybar/scripts/select.sh",
        "signal": 8
    },
    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤫",
        "interval": 5,
        "tooltip-format": "{essid} ({signalStrength}%)",
        "on-click": "ghostty nmtui"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}% 󰂲",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", " "]
        },
        "on-click": "pavucontrol"
    },
    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": ["", "󰃜", "󰃛", "󰃞", "󰃝", "󰃟", "󰃠"]
    },
    "battery": {
        "interval": 2,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-full": "{icon}  {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon}  {time}",
        "format-icons": ["", "", "", "", ""]
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "$HOME/.config/waybar/scripts/powermenu.sh"
    }
}
